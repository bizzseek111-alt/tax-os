model ReviewTeam {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  domain         String       @default("INCOME_TAX")
  jurisdiction   String?
  leadUserId     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members ReviewTeamMembership[]
  tasks   ReviewTask[]

  @@index([organizationId, domain])
}

model ReviewTeamMembership {
  id       String     @id @default(uuid())
  teamId   String
  team     ReviewTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String     @default("MEMBER") // LEAD, SENIOR, MEMBER
  joinedAt DateTime   @default(now())

  @@unique([teamId, userId])
}

model CustomerRequest {
  id                 String      @id @default(uuid())
  taxCaseId          String
  taxCase            TaxCase     @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  reviewTaskId       String?
  reviewTask         ReviewTask? @relation(fields: [reviewTaskId], references: [id], onDelete: SetNull)
  taxPositionId      String?
  requestType        String // QUESTION, DOCUMENT_REQUEST, CONFIRMATION, SIGNATURE_REQUEST, PAYMENT_INFORMATION
  prompt             String
  reason             String
  expectedAnswerType String      @default("TEXT") // TEXT, NUMBER, BOOLEAN, DOCUMENT, SIGNATURE
  options            Json        @default("[]")
  responsePayload    Json?
  responseDocumentId String?
  status             String      @default("PENDING") // PENDING, RESPONDED, EXPIRED, CANCELLED
  deadline           DateTime?
  requestedByUserId  String
  respondedAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt


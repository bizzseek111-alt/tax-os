// Autonomous Tax OS — Production PostgreSQL Schema
// Workstream Phase 1 & 2: Persistence, Identity, Ingestion, Financial Connectivity, Evidence Graph

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  TAXPAYER
  BUSINESS_OWNER
  CFO
  CPA
  EA
  PAID_PREPARER
  FEDERAL_REVIEWER
  STATE_REVIEWER
  SALES_TAX_REVIEWER
  PAYROLL_REVIEWER
  BUSINESS_TAX_REVIEWER
  SENIOR_REVIEWER
  ATTORNEY
  OPERATIONS_MANAGER
  CASE_MANAGER
  CUSTOMER_SUPPORT
  FIRM_ADMIN
  ORG_ADMIN
  TAX_KNOWLEDGE_ADMIN
  SECURITY_ADMIN
  SUPER_ADMIN
}

enum SubscriptionTier {
  PERSONAL_FREE
  PERSONAL_PRO
  BUSINESS_CORE
  FULL_TAX_OS
  ENTERPRISE_FIRM
}

enum CaseType {
  INDIVIDUAL_INCOME
  BUSINESS_INCOME
  SALES_TAX
  PAYROLL_TAX
  MULTI_DOMAIN_BUSINESS
}

enum ReviewMode {
  AI_AUTOPILOT
  HUMAN_VERIFIED
  FULL_SERVICE
}

enum CaseStatus {
  DRAFT
  DISCOVERY
  DOCUMENT_INTAKE
  NEEDS_YOU
  CALCULATING
  READY_FOR_REVIEW
  IN_REVIEW
  APPROVED
  FILED
  TRANSMITTED
  ACCEPTED
  REJECTED
  ARCHIVED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaxDomain {
  INCOME_TAX
  SALES_TAX
  PAYROLL_TAX
  EMPLOYER_COMPLIANCE
}

enum ObligationStatus {
  NOT_STARTED
  IN_PROGRESS
  READY_FOR_CALCULATION
  CALCULATED
  REVIEW_PENDING
  REVIEW_APPROVED
  TRANSMITTED
  ACCEPTED
  REJECTED
}

enum CredentialType {
  CPA
  ENROLLED_AGENT
  TAX_ATTORNEY
  CTEC_PREPARER
  ANNUAL_FILING_SEASON_PROGRAM
  STAFF_PREPARER
}

enum CredentialStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  PENDING_VERIFICATION
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  AWAY
  OFFLINE
}

enum TaskOwnerType {
  AI
  TAXPAYER
  CPA
  EA
  PREPARER
  ATTORNEY
  SALES_TAX_SPECIALIST
  PAYROLL_SPECIALIST
  OPERATIONS
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  AWAITING_INPUT
  PENDING_TAXPAYER
  ESCALATED
  RESOLVED
  DISMISSED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DocumentType {
  FORM_W2
  FORM_1099_NEC
  FORM_1099_MISC
  FORM_1099_K
  FORM_1099_B
  FORM_1099_DIV
  FORM_1099_INT
  FORM_1098_MORTGAGE
  FORM_1098_E
  FORM_1098_T
  FORM_1040_PRIOR_YEAR
  SCHEDULE_C
  SCHEDULE_D
  SCHEDULE_E
  SCHEDULE_K1
  RECEIPT_EXPENSE
  INVOICE_SALES
  PAYROLL_REPORT
  BANK_FEED_CSV
  BANK_STATEMENT
  CREDIT_CARD_STATEMENT
  BROKERAGE_STATEMENT
  RESALE_CERTIFICATE
  LEGAL_CONTRACT
  UNKNOWN
}

enum DocumentStatus {
  UPLOADED
  VIRUS_SCANNED
  PROCESSING
  PROCESSED
  VERIFIED
  DUPLICATE_REMOVED
  ERROR
}

enum DocumentProcessingState {
  UPLOADED
  SCANNING
  QUEUED
  CLASSIFYING
  EXTRACTING
  NORMALIZING
  VALIDATING
  MATCHING
  READY
  NEEDS_REVIEW
  FAILED
  DUPLICATE
}

enum DuplicateType {
  EXACT_DUPLICATE
  PROBABLE_DUPLICATE
  RELATED_DOCUMENT
}

enum FactValidationStatus {
  EXTRACTED
  VALIDATED
  CONFLICTED
  USER_CONFIRMED
  PROFESSIONAL_CONFIRMED
  REJECTED
}

enum EvidenceType {
  DOCUMENT
  FINANCIAL_ACCOUNT
  TRANSACTION
  USER_CONFIRMATION
  PROFESSIONAL_CONFIRMATION
  DERIVED
}

enum ExtractionStatus {
  NOT_STARTED
  EXTRACTING
  EXTRACTED
  FAILED
}

// ============================================================================
// IDENTITY & MULTI-TENANCY
// ============================================================================

model Organization {
  id        String           @id @default(uuid())
  name      String
  slug      String           @unique
  fein      String?
  tier      SubscriptionTier @default(FULL_TAX_OS)
  settings  Json             @default("{}")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  memberships           OrganizationMembership[]
  taxCases              TaxCase[]
  documents             Document[]
  businessProfiles      BusinessProfile[]
  auditEvents           AuditEvent[]
  integrations          IntegrationConnection[]
  accessGrants          PrivilegedPiiAccessGrant[]
  financialConnections  FinancialConnection[]
  resolvedEntities      ResolvedEntity[]
  ingestionJobs         IngestionJob[]
  agentMemories         AgentMemory[]
  reviewTeams           ReviewTeam[]
  professionalProfiles  ProfessionalProfile[]
  salesTaxProfiles      SalesTaxProfile[]
  salesTaxRegistrations SalesTaxRegistration[]
  productTaxCategories  ProductTaxCategory[]
  salesTaxCustomers     SalesTaxCustomer[]
  exemptionCertificates ExemptionCertificate[]
  salesTransactions     SalesTransaction[]
  salesTaxReturns       SalesTaxReturn[]
  salesTaxNotices       SalesTaxNotice[]
  employers             Employer[]
  payrollNotices        PayrollNotice[]
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  fullName        String
  role            UserRole  @default(TAXPAYER)
  isMfaEnabled    Boolean   @default(false)
  mfaSecret       String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userProfile          UserProfile?
  professionalProfile  ProfessionalProfile?
  taxpayerProfile      TaxpayerProfile?
  memberships          OrganizationMembership[]
  credentials          Credential[]
  ownedTaxCases        TaxCase[]                  @relation("CaseOwner")
  assignedReviews      ReviewTask[]               @relation("ReviewerAssigned")
  reviewedCases        ProfessionalReview[]
  uploadedDocs         Document[]                 @relation("DocumentUploader")
  auditEvents          AuditEvent[]
  consents             Consent[]
  piiAccessGrants      PrivilegedPiiAccessGrant[]
  assignedTasks        TaxTask[]                  @relation("TaskOwnerUser")
  financialConnections FinancialConnection[]
  teamMemberships      ReviewTeamMembership[]
  sentMessages         TaxCaseMessage[]
  qaReviews            QualityReview[]
  reviewSignoffs       ReviewSignoff[]
  caseLocks            CaseLock[]
}

model UserProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone            String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  taxResidentState String?  @default("US-CA")
  avatarUrl        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model OrganizationMembership {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           UserRole     @default(TAXPAYER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
}

model ProfessionalProfile {
  id                      String             @id @default(uuid())
  userId                  String             @unique
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId          String?
  organization            Organization?      @relation(fields: [organizationId], references: [id])
  credentialType          CredentialType     @default(CPA)
  credentialNumber        String
  credentialState         String? // e.g. "CA", "NY"
  credentialStatus        CredentialStatus   @default(ACTIVE)
  credentialExpiration    DateTime?
  ptin                    String?
  efin                    String?
  stateBarOrBoard         String?
  authorizedJurisdictions String[] // e.g. ["US-FED", "US-CA", "US-NY"]
  authorizedTaxDomains    String[] // e.g. ["INCOME_TAX", "SALES_TAX", "PAYROLL_TAX"]
  reviewLevel             Int                @default(1) // 1 = Staff/Preparer, 2 = Senior, 3 = Manager/Partner
  qualityStatus           String             @default("GOOD_STANDING")
  qualityScore            Float              @default(100.0)
  availabilityStatus      AvailabilityStatus @default(AVAILABLE)
  capacity                Int                @default(25)
  maxActiveCaseCapacity   Int                @default(25)
  currentActiveCases      Int                @default(0)
  supervisorId            String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
}

model Credential {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        CredentialType
  identifier  String // e.g. PTIN P01948291 or CA CPA #129481
  issuingBody String // e.g. "IRS Return Preparer Office", "California Board of Accountancy"
  status      CredentialStatus @default(ACTIVE)
  expiresAt   DateTime?
  verifiedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model TaxpayerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filingStatus    String   @default("SINGLE") // SINGLE, MARRIED_JOINT, etc.
  ssnEncrypted    String?
  ssnLast4        String?
  occupation      String?
  dependentsCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BusinessProfile {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalName          String
  dba                String?
  entityType         String // S_CORP, C_CORP, LLC, PARTNERSHIP, SOLE_PROP
  fein               String?
  naicsCode          String?
  incorporationState String?
  headquartersState  String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

// ============================================================================
// CANONICAL TAX CASE AGGREGATE
// ============================================================================

model TaxCase {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User         @relation("CaseOwner", fields: [ownerId], references: [id])
  taxYear        Int          @default(2026)
  caseType       CaseType     @default(INDIVIDUAL_INCOME)
  reviewMode     ReviewMode   @default(HUMAN_VERIFIED)
  status         CaseStatus   @default(DRAFT)
  riskLevel      RiskLevel    @default(LOW)

  // High-Level Calculation Rollup (Integer Cents)
  grossIncomeCents        BigInt @default(0)
  deductionsCents         BigInt @default(0)
  taxableIncomeCents      BigInt @default(0)
  federalRefundOrDueCents BigInt @default(0)
  stateDueCents           BigInt @default(0)
  completionPercent       Int    @default(0)

  auditHash String   @default("genesis")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  obligations               TaxObligation[]
  tasks                     TaxTask[]
  facts                     TaxFact[]
  positions                 TaxPosition[]
  decisions                 TaxDecision[]
  calculations              TaxCalculation[]
  reviews                   TaxReview[]
  professionalReviews       ProfessionalReview[]
  reviewTasks               ReviewTask[]
  filings                   TaxFiling[]
  documents                 Document[]
  evidence                  Evidence[]
  agentRuns                 AgentRun[]
  auditEvents               AuditEvent[]
  piiAccessGrants           PrivilegedPiiAccessGrant[]
  transactions              Transaction[]
  ingestionJobs             IngestionJob[]
  calculationRuns           TaxCalculationRun[]
  corrections               ProfessionalCorrection[]
  customerRequests          CustomerRequest[]
  caseMessages              TaxCaseMessage[]
  qualityReviews            QualityReview[]
  reviewSignoffs            ReviewSignoff[]
  caseLock                  CaseLock?
  salesTaxProfiles          SalesTaxProfile[]
  economicNexusMeasurements EconomicNexusMeasurement[]
  physicalNexusFacts        PhysicalNexusFact[]
  nexusEvents               NexusEvent[]
  salesTransactions         SalesTransaction[]
  taxabilityDecisions       TaxabilityDecision[]
  useTaxPositions           UseTaxPosition[]
  salesTaxReturnPeriods     SalesTaxReturnPeriod[]
  salesTaxReturns           SalesTaxReturn[]
  payrollRuns               PayrollRun[]
  workerClassifications     WorkerClassificationCase[]
  payrollLiabilities         PayrollTaxLiability[]
  payrollReturns            PayrollReturn[]
  payrollReconciliations    PayrollReconciliation[]
  returnVersions            ReturnVersion[]
  filingSubmissions         FilingSubmission[]
  taxpayerAuthorizations    TaxpayerAuthorization[]
  filingPayments            FilingPayment[]
  filingExtensions          FilingExtension[]
  amendmentCases            AmendmentCase[]
  deletionRequests          DataDeletionRequest[]

  @@index([organizationId, taxYear])
  @@index([ownerId])
  @@index([status])
}

model TaxObligation {
  id                 String           @id @default(uuid())
  taxCaseId          String
  taxCase            TaxCase          @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  taxDomain          TaxDomain
  jurisdictionCode   String // e.g. "US-FED", "US-CA", "CA-CDTFA", "PAYROLL-FED"
  period             String // e.g. "2026-ANNUAL", "2026-Q1"
  status             ObligationStatus @default(NOT_STARTED)
  ruleSetVersion     String           @default("2026.1")
  calculationVersion String?
  reviewStatus       String           @default("PENDING")
  filingStatus       String           @default("UNFILED")
  dueDate            DateTime
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tasks           TaxTask[]
  positions       TaxPosition[]
  reviewTasks     ReviewTask[]
  filings         TaxFiling[]
  facts           TaxFact[]
  calculationRuns TaxCalculationRun[]
  agentRuns       AgentRun[]
  salesTaxReturns    SalesTaxReturn[]
  payrollLiabilities PayrollTaxLiability[]
  payrollReturns     PayrollReturn[]
  filingSubmissions  FilingSubmission[]

  @@unique([taxCaseId, jurisdictionCode, period])
  @@index([jurisdictionCode])
}

model TaxJurisdiction {
  code          String   @id // e.g. "US-FED", "US-CA", "US-NY"
  name          String
  country       String   @default("US")
  level         String // FEDERAL, STATE, LOCAL, SPECIAL_DISTRICT
  authorityName String // IRS, FTB, NYS-DTF, CDTFA
  portalUrl     String?
  createdAt     DateTime @default(now())
}

model TaxTask {
  id                   String         @id @default(uuid())
  taxCaseId            String
  taxCase              TaxCase        @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  taxObligationId      String?
  taxObligation        TaxObligation? @relation(fields: [taxObligationId], references: [id], onDelete: SetNull)
  taskType             String
  ownerType            TaskOwnerType  @default(TAXPAYER)
  ownerId              String?
  ownerUser            User?          @relation("TaskOwnerUser", fields: [ownerId], references: [id])
  status               TaskStatus     @default(PENDING_TAXPAYER)
  priority             TaskPriority   @default(MEDIUM)
  reason               String
  financialImpactCents BigInt?
  requiredEvidence     Json           @default("[]")
  resolutionChoice     String?
  resolvedAt           DateTime?
  auditRecordHash      String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([taxCaseId, status])
}

model TaxFact {
  id                 String               @id @default(uuid())
  taxCaseId          String
  taxCase            TaxCase              @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  taxObligationId    String?
  taxObligation      TaxObligation?       @relation(fields: [taxObligationId], references: [id], onDelete: SetNull)
  category           String // INCOME, EXPENSE, DEDUCTION, ASSET, WITHHOLDING
  factType           String               @default("GENERAL") // W2_WAGES, 1099_NEC_COMP, MORTGAGE_INTEREST
  key                String // e.g. "w2_box1_wages", "schedule_c_software_aws"
  valueCents         BigInt?
  valueString        String?
  normalizedValue    Json?
  unit               String?
  taxYear            Int?
  jurisdiction       String?
  sourceDocumentId   String?
  sourcePage         Int?
  sourceRegion       Json?
  extractionProvider String?
  confidence         Float                @default(1.0)
  validationStatus   FactValidationStatus @default(VALIDATED)
  conflictDetails    Json?
  isVerified         Boolean              @default(false)
  verifiedByUserId   String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  evidence Evidence[]

  @@index([taxCaseId, key])
  @@index([validationStatus])
}

model TaxPosition {
  id                String         @id @default(uuid())
  taxCaseId         String
  taxCase           TaxCase        @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  taxObligationId   String?
  taxObligation     TaxObligation? @relation(fields: [taxObligationId], references: [id], onDelete: SetNull)
  positionType      String // DEDUCTION, CREDIT, INCOME_ADJUSTMENT, EXEMPTION
  category          String         @default("GENERAL") // SCHEDULE_C, HOME_OFFICE, VEHICLE, QBI, RETIREMENT, etc.
  title             String         @default("Tax Position")
  statutoryCitation String // e.g. "26 U.S.C. § 162(a)"
  amountCents       BigInt
  rationale         String
  riskScore         Float          @default(0.0)
  confidence        Float          @default(1.0)
  status            String         @default("PROPOSED") // PROPOSED, INVESTIGATING, AWAITING_FACT, RULE_VERIFIED, EVIDENCE_VERIFIED, CHALLENGED, APPROVED, REJECTED, PRO_REVIEW, FINAL
  ruleRefs          Json           @default("[]")
  evidenceRefs      Json           @default("[]")
  challengerNotes   String?
  proReviewNotes    String?
  sourceAgent       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  decisions   TaxDecision[]
  reviewTasks ReviewTask[]
  evidence    Evidence[]

  @@index([taxCaseId, status])
  @@index([category])
}

model TaxDecision {
  id             String       @id @default(uuid())
  taxCaseId      String
  taxCase        TaxCase      @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  taxPositionId  String?
  taxPosition    TaxPosition? @relation(fields: [taxPositionId], references: [id], onDelete: SetNull)
  deciderType    String // "AI_CONSENSUS", "CPA_OVERRIDE", "ATTORNEY_MEMO"
  deciderId      String
  decisionAction String // "APPROVED", "ADJUSTED", "DISALLOWED"
  rationale      String
  auditHash      String
  createdAt      DateTime     @default(now())
}

model TaxCalculation {
  id              String   @id @default(uuid())
  taxCaseId       String
  taxCase         TaxCase  @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  engineVersion   String
  calculationHash String
  inputsHash      String
  outputsJson     Json
  isOfficial      Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model TaxCalculationRun {
  id                String         @id @default(uuid())
  taxCaseId         String
  taxCase           TaxCase        @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  taxObligationId   String?
  taxObligation     TaxObligation? @relation(fields: [taxObligationId], references: [id])
  jurisdiction      String         @default("US-FED")
  taxYear           Int            @default(2026)
  engineVersion     String         @default("2026.1.0-alpha")
  ruleSetVersion    String         @default("2026.Q1")
  provider          String         @default("INTERNAL_DETERMINISTIC")
  inputSnapshotHash String
  inputSnapshot     Json
  outputSnapshot    Json
  outputHash        String
  status            String         @default("COMPLETED") // COMPLETED, FAILED, UNSUPPORTED
  startedAt         DateTime       @default(now())
  completedAt       DateTime?
  errors            Json           @default("[]")
  warnings          Json           @default("[]")
  createdAt         DateTime       @default(now())

  @@index([taxCaseId, jurisdiction, taxYear])
  @@index([inputSnapshotHash])
}

model TaxParameter {
  id            String    @id @default(uuid())
  key           String
  jurisdiction  String // "US-FED", "US-CA", "US-NY", "US-NJ", "US-IL", "US-MA"
  taxYear       Int       @default(2026)
  value         Json
  effectiveFrom DateTime
  effectiveTo   DateTime?
  sourceRef     String // Statutory citation, e.g. "26 U.S.C. § 1", "Cal. RTC § 17041"
  version       String    @default("2026.1")
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([key, jurisdiction, taxYear, version])
  @@index([jurisdiction, taxYear])
}

model TaxReview {
  id              String     @id @default(uuid())
  taxCaseId       String
  taxCase         TaxCase    @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  reviewMode      ReviewMode @default(HUMAN_VERIFIED)
  status          String     @default("PENDING")
  findings        Json       @default("[]")
  recommendations Json       @default("[]")
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
}

model ProfessionalReview {
  id            String    @id @default(uuid())
  taxCaseId     String
  taxCase       TaxCase   @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User      @relation(fields: [reviewerId], references: [id])
  ptin          String
  jurisdiction  String
  domain        TaxDomain
  overrideCount Int       @default(0)
  signoffHash   String
  signedAt      DateTime?
  createdAt     DateTime  @default(now())
}

model ReviewTask {
  id                     String              @id @default(uuid())
  taxCaseId              String
  taxCase                TaxCase             @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  taxObligationId        String?
  taxObligation          TaxObligation?      @relation(fields: [taxObligationId], references: [id], onDelete: SetNull)
  taxPositionId          String?
  taxPosition            TaxPosition?        @relation(fields: [taxPositionId], references: [id], onDelete: SetNull)
  calculationRunId       String?
  reviewType             String              @default("FINAL_RETURN_REVIEW")
  taxDomain              TaxDomain           @default(INCOME_TAX)
  jurisdiction           String // e.g. "US-CA", "US-FED"
  requiredRole           UserRole            @default(CPA)
  requiredCredential     String?
  assignedUserId         String?
  assignedUser           User?               @relation("ReviewerAssigned", fields: [assignedUserId], references: [id])
  assignedTeamId         String?
  assignedTeam           ReviewTeam?         @relation(fields: [assignedTeamId], references: [id])
  riskLevel              RiskLevel           @default(LOW)
  materialityCents       BigInt              @default(0)
  priority               String              @default("MEDIUM")
  status                 String              @default("UNASSIGNED") // UNASSIGNED, ASSIGNED, IN_REVIEW, WAITING_ON_CUSTOMER, WAITING_ON_AI, WAITING_ON_DOCUMENT, WAITING_ON_SECOND_REVIEWER, WAITING_ON_ATTORNEY, CHANGES_REQUIRED, APPROVED, REJECTED, CANCELLED, COMPLETED
  deadline               DateTime
  dueAt                  DateTime?
  slaPolicyId            String?
  slaPolicy              ServiceLevelPolicy? @relation(fields: [slaPolicyId], references: [id])
  createdBy              String?
  decision               Json?
  decisionReason         String?
  notes                  String?
  professionalNotes      String?
  customerVisibleSummary String?
  qualityReviewRequired  Boolean             @default(false)
  isPrivileged           Boolean             @default(false)
  createdAt              DateTime            @default(now())
  startedAt              DateTime?
  completedAt            DateTime?

  customerRequests CustomerRequest[]
  qualityReviews   QualityReview[]

  @@index([taxCaseId, status])
  @@index([assignedUserId])
  @@index([jurisdiction, taxDomain])
}

model TaxFiling {
  id               String         @id @default(uuid())
  taxCaseId        String
  taxCase          TaxCase        @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  taxObligationId  String?
  taxObligation    TaxObligation? @relation(fields: [taxObligationId], references: [id], onDelete: SetNull)
  formIdentifier   String // e.g. "Form 1040", "Form 540", "CDTFA-401"
  submissionId     String?        @unique
  transmissionHash String?
  status           String         @default("DRAFT") // DRAFT, SIGNED, TRANSMITTED, ACCEPTED, REJECTED
  acceptanceCode   String?
  submittedAt      DateTime?
  acknowledgedAt   DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ============================================================================
// DOCUMENTS, EVIDENCE & AUDIT
// ============================================================================

model Document {
  id                  String                  @id @default(uuid())
  organizationId      String
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxCaseId           String?
  taxCase             TaxCase?                @relation(fields: [taxCaseId], references: [id], onDelete: SetNull)
  ownerId             String
  owner               User                    @relation("DocumentUploader", fields: [ownerId], references: [id])
  documentFamilyId    String                  @default(uuid())
  version             Int                     @default(1)
  filename            String
  originalFilename    String                  @default("")
  mimeType            String
  sizeBytes           BigInt
  storageKey          String // Key in S3 or local vault
  sha256              String // True cryptographic SHA-256
  documentType        DocumentType            @default(UNKNOWN)
  taxYear             Int                     @default(2026)
  status              DocumentStatus          @default(UPLOADED)
  processingState     DocumentProcessingState @default(UPLOADED)
  extractionStatus    ExtractionStatus        @default(NOT_STARTED)
  scanStatus          String                  @default("CLEAN")
  duplicateOfId       String?
  duplicateType       DuplicateType?
  duplicateConfidence Float?
  duplicateReason     String?
  ocrRaw              Json?
  ocrNormalizedText   String?
  ocrMetadata         Json?
  processingError     String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  evidence Evidence[]

  @@index([organizationId])
  @@index([taxCaseId])
  @@index([sha256])
  @@index([documentFamilyId, version])
  @@index([processingState])
}

model Evidence {
  id                 String            @id @default(uuid())
  taxCaseId          String
  taxCase            TaxCase           @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  evidenceType       EvidenceType      @default(DOCUMENT)
  documentId         String?
  document           Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)
  factId             String?
  fact               TaxFact?          @relation(fields: [factId], references: [id], onDelete: SetNull)
  positionId         String?
  position           TaxPosition?      @relation(fields: [positionId], references: [id], onDelete: SetNull)
  transactionId      String?
  transaction        Transaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  financialAccountId String?
  financialAccount   FinancialAccount? @relation(fields: [financialAccountId], references: [id], onDelete: SetNull)
  relationType       String // "SUBSTANTIATES", "PROVES_LINE", "ATTRIBUTES_INCOME", "FINGERPRINT_MATCH"
  hash               String
  confidence         Float             @default(1.0)
  createdBy          String?
  createdAt          DateTime          @default(now())

  @@index([taxCaseId])
  @@index([documentId])
  @@index([factId])
}

model AgentRun {
  id              String         @id @default(uuid())
  agentType       String         @default("INTAKE_AGENT")
  agentVersion    String         @default("1.0.0")
  taxCaseId       String
  taxCase         TaxCase        @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  taxObligationId String?
  taxObligation   TaxObligation? @relation(fields: [taxObligationId], references: [id], onDelete: SetNull)
  status          String         @default("SUCCESS") // SUCCESS, PARTIAL, RETRYABLE_FAILURE, PERMANENT_FAILURE, BLOCKED_MISSING_DATA, BLOCKED_RULE_UNCERTAINTY, PRO_REVIEW_REQUIRED
  modelProvider   String         @default("INTERNAL_DETERMINISTIC") // "GOOGLE", "OPENAI", "ANTHROPIC", "INTERNAL_DETERMINISTIC"
  modelName       String         @default("taxos-deterministic-v1")
  inputRefs       Json           @default("[]")
  outputRefs      Json           @default("[]")
  toolCalls       Json           @default("[]")
  confidence      Float          @default(1.0)
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
  retryCount      Int            @default(0)
  error           String?
  humanOverride   Json?
  costMetadata    Json           @default("{}")
  ruleSetVersion  String?        @default("2026.1")
  finalVerdict    Json?
  signatureHash   String?
  createdAt       DateTime       @default(now())

  // Backwards compatibility fields
  agentName        String?
  modelVersion     String?
  promptTokens     Int     @default(0)
  completionTokens Int     @default(0)
  costUsd          Float   @default(0.0)
  latencyMs        Int     @default(0)
  toolInvocations  Json    @default("[]")

  @@index([taxCaseId, agentType])
  @@index([status])
}

model AuditEvent {
  id                String       @id @default(uuid())
  sequence          BigInt       @default(autoincrement())
  timestamp         DateTime     @default(now())
  actorId           String
  actor             User         @relation(fields: [actorId], references: [id])
  actorRole         UserRole
  actorType         String // "USER", "AGENT", "SYSTEM"
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxCaseId         String?
  taxCase           TaxCase?     @relation(fields: [taxCaseId], references: [id], onDelete: SetNull)
  action            String // e.g. "MUTATE_TAX_POSITION", "UNMASK_PII", "SUBMIT_EFILE", "OCR_EXTRACTED"
  objectType        String
  objectId          String
  previousValue     Json?
  newValue          Json?
  reason            String?
  requestId         String?
  blockHash         String // Real SHA-256 block hash
  previousBlockHash String

  @@index([organizationId])
  @@index([taxCaseId])
  @@index([sequence])
}

model Consent {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  consentType    String // "CIRCULAR_230", "IRC_7216_DISCLOSURE", "PLAID_CONNECTION", "TERMS_OF_SERVICE"
  consentText    String
  ipAddress      String?
  userAgent      String?
  agreedAt       DateTime  @default(now())
  revokedAt      DateTime?
}

model IntegrationConnection {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider             String // "PLAID", "STRIPE", "GUSTO", "SHOPIFY"
  status               String       @default("CONNECTED")
  authPayloadEncrypted String?
  lastSyncedAt         DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

model PrivilegedPiiAccessGrant {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxCaseId      String
  taxCase        TaxCase      @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  targetRecordId String
  reason         String
  authFactorUsed String // "PASSWORD_REAUTH", "WEBAUTHN_FIDO2", "TOTP"
  grantedAt      DateTime     @default(now())
  expiresAt      DateTime // Strictly 15 minutes after grantedAt
  revokedAt      DateTime?
  auditEventId   String?
}

// ============================================================================
// FINANCIAL CONNECTIVITY & TRANSACTIONS (PHASE 2)
// ============================================================================

model FinancialConnection {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId               String
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             String // "PLAID", "STRIPE", "SANDBOX"
  providerConnectionId String
  institutionId        String?
  institutionName      String
  status               String       @default("CONNECTED") // CONNECTED, DEGRADED, DISCONNECTED, ERROR
  encryptedAccessToken String?
  lastSyncedAt         DateTime?
  scopes               Json         @default("[]")
  consentVersion       String?
  consentedAt          DateTime     @default(now())
  revokedAt            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  accounts FinancialAccount[]

  @@unique([organizationId, provider, providerConnectionId])
  @@index([organizationId])
}

model FinancialAccount {
  id                    String              @id @default(uuid())
  connectionId          String
  connection            FinancialConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  organizationId        String
  providerAccountId     String
  accountName           String
  accountType           String // depository, credit, loan, investment
  accountSubtype        String? // checking, savings, credit card
  mask                  String? // e.g. "6789"
  currency              String              @default("USD")
  currentBalanceCents   BigInt?
  availableBalanceCents BigInt?
  status                String              @default("ACTIVE")
  lastSyncedAt          DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  transactions Transaction[]
  evidence     Evidence[]

  @@unique([connectionId, providerAccountId])
  @@index([organizationId])
}

model Transaction {
  id                    String           @id @default(uuid())
  accountId             String
  account               FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  organizationId        String
  taxCaseId             String?
  taxCase               TaxCase?         @relation(fields: [taxCaseId], references: [id], onDelete: SetNull)
  providerTransactionId String?
  date                  DateTime
  authorizedDate        DateTime?
  rawMerchant           String?
  normalizedMerchant    String?
  description           String
  amountCents           BigInt
  currency              String           @default("USD")
  direction             String // DEBIT, CREDIT
  rawCategory           Json             @default("[]")
  normalizedCategory    String?
  isPending             Boolean          @default(false)
  source                String // "PLAID", "CSV_IMPORT", "STRIPE"
  fingerprint           String // SHA-256 duplicate fingerprint
  duplicateOfId         String?
  isDuplicate           Boolean          @default(false)
  duplicateConfidence   Float?
  duplicateReason       String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  evidence Evidence[]

  @@index([organizationId, date])
  @@index([fingerprint])
}

model ResolvedEntity {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType        String // "EMPLOYER", "PAYER", "MERCHANT", "FINANCIAL_INSTITUTION", "BUSINESS_ENTITY"
  name              String
  normalizedName    String
  tinOrEinEncrypted String?
  tinLast4          String?
  confidence        Float        @default(1.0)
  metadata          Json         @default("{}")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId, normalizedName])
}

model IngestionJob {
  id             String       @id @default(uuid())
  jobType        String // DOCUMENT_UPLOAD_RECEIVED, FINANCIAL_ACCOUNT_SYNC, etc.
  taxCaseId      String?
  taxCase        TaxCase?     @relation(fields: [taxCaseId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentId     String?
  status         String       @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, DEAD_LETTER
  attemptCount   Int          @default(0)
  maxAttempts    Int          @default(3)
  payload        Json
  result         Json?
  errorDetails   Json?
  auditReference String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
}

// ============================================================================
// TAX AUTHORITY ENGINE, RAG & RULE GRAPH (PHASE 4)
// ============================================================================

model TaxAuthoritySource {
  id                   String    @id @default(uuid())
  jurisdiction         String // "US-FED", "US-CA", "US-NY", "US-NJ", "US-IL", "US-MA"
  taxYear              Int       @default(2026)
  authorityType        String // STATUTE, REGULATION, COURT_DECISION, REVENUE_RULING, etc.
  authorityLevel       Int // 1 = STATUTE (highest), 15 = SECONDARY_COMMENTARY (lowest)
  publisher            String // "INTERNAL_REVENUE_SERVICE", "CA_FRANCHISE_TAX_BOARD", etc.
  title                String
  sourceUrl            String?
  citationCode         String // e.g. "26 U.S.C. § 199A", "Cal. RTC § 17041"
  publicationDate      DateTime?
  effectiveFrom        DateTime
  effectiveTo          DateTime?
  supersedesSourceId   String?
  supersededBySourceId String?
  precedentialStatus   String    @default("BINDING") // BINDING, PERSUASIVE, ADMINISTRATIVE, SUPERSEDED, PROPOSED, HISTORICAL
  affectedForms        Json      @default("[]")
  affectedSchedules    Json      @default("[]")
  topicTags            Json      @default("[]")
  retrievedAt          DateTime  @default(now())
  contentHash          String // SHA-256 hash of raw content
  sourceVersion        String    @default("2026.1")
  reviewStatus         String    @default("APPROVED") // DRAFT, UNDER_REVIEW, APPROVED, REJECTED, ARCHIVED
  rawContent           String    @db.Text
  normalizedContent    String    @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  chunks TaxAuthorityChunk[]
  rules  TaxRule[]

  @@unique([jurisdiction, citationCode, taxYear, sourceVersion])
  @@index([jurisdiction, taxYear])
  @@index([authorityType, authorityLevel])
  @@index([contentHash])
}

model TaxAuthorityChunk {
  id                 String             @id @default(uuid())
  sourceId           String
  source             TaxAuthoritySource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  jurisdiction       String
  taxYear            Int                @default(2026)
  sectionPath        String // e.g. "§ 199A > (b) > (2) > (A)"
  heading            String?
  content            String             @db.Text
  pageNumber         Int?
  lineNumber         Int?
  authorityLevel     Int
  precedentialStatus String             @default("BINDING")
  embedding          Json? // Float array representation
  embeddingModel     String?            @default("deterministic-tax-v1")
  embeddingVersion   String?            @default("1.0.0")
  createdAt          DateTime           @default(now())

  @@index([sourceId])
  @@index([jurisdiction, taxYear])
  @@index([authorityLevel, precedentialStatus])
}

model TaxRule {
  id                        String              @id @default(uuid())
  ruleId                    String              @unique // e.g. "FED-SEC-199A-QBI-DEDUCTION"
  jurisdiction              String // "US-FED", "US-CA", "US-NY", "US-NJ", "US-IL", "US-MA"
  taxYear                   Int                 @default(2026)
  taxDomain                 String              @default("INCOME_TAX")
  topic                     String // QUALIFIED_BUSINESS_INCOME, SELF_EMPLOYMENT_TAX, etc.
  title                     String
  description               String              @db.Text
  conditions                Json // AST condition expression
  requiredFacts             Json                @default("[]")
  exceptions                Json                @default("[]")
  thresholds                Json                @default("{}")
  phaseOuts                 Json                @default("{}")
  elections                 Json                @default("{}")
  calculationReference      String? // Deterministic engine reference e.g. "federalEngine.calculateQbiDeduction"
  formMappings              Json                @default("[]")
  federalConformityBehavior String?             @default("CONFORMS") // CONFORMS, DECOUPLED, MODIFIED, NOT_APPLICABLE
  authorityRefs             Json                @default("[]")
  ruleVersion               String              @default("2026.1")
  reviewStatus              String              @default("ACTIVE") // DRAFT, AI_EXTRACTED, PRO_REVIEW_REQUIRED, APPROVED, ACTIVE, DEPRECATED
  approvedByUserId          String?
  approvedAt                DateTime?
  effectiveFrom             DateTime
  effectiveTo               DateTime?
  sourceId                  String?
  source                    TaxAuthoritySource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  conformityRecords FederalStateConformity[] @relation("FederalRuleConformity")

  @@unique([ruleId, taxYear, ruleVersion])
  @@index([jurisdiction, taxYear])
  @@index([topic])
  @@index([reviewStatus])
}

model FederalStateConformity {
  id                  String    @id @default(uuid())
  federalRuleId       String
  federalRule         TaxRule   @relation("FederalRuleConformity", fields: [federalRuleId], references: [ruleId], onDelete: Cascade)
  state               String // "US-CA", "US-NY", "US-NJ", "US-IL", "US-MA"
  taxYear             Int       @default(2026)
  conformityStatus    String // ROLLING_CONFORMITY, FIXED_DATE_CONFORMITY, SELECTIVE_DECOUPLING, COMPLETELY_INDEPENDENT
  stateAdjustmentRule Json // Adjustment specifications
  authorityRefs       Json      @default("[]")
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([federalRuleId, state, taxYear])
  @@index([state, taxYear])
  @@index([conformityStatus])
}

model TaxRuleSetVersion {
  id               String   @id @default(uuid())
  jurisdiction     String
  taxYear          Int      @default(2026)
  versionCode      String // e.g. "FED-2026.1"
  rulesCount       Int      @default(0)
  contentHash      String // SHA-256 checksum of canonical rules
  status           String   @default("RELEASED") // DRAFT, RELEASED, ARCHIVED
  releasedAt       DateTime @default(now())
  releasedByUserId String?
  createdAt        DateTime @default(now())

  @@unique([jurisdiction, taxYear, versionCode])
  @@index([jurisdiction, taxYear])
}

model CitationVerificationRecord {
  id                 String   @id @default(uuid())
  citationCode       String
  jurisdiction       String
  taxYear            Int      @default(2026)
  isVerified         Boolean
  verificationStatus String // VERIFIED, INVALID_CITATION, WRONG_JURISDICTION, WRONG_YEAR, SUPERSEDED, AMBIGUOUS
  sourceId           String?
  chunkId            String?
  reasons            Json     @default("[]")
  verifiedAt         DateTime @default(now())

  @@index([citationCode, jurisdiction, taxYear])
}


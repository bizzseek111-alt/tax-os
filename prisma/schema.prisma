model Employer {
  id                   String           @id @default(uuid())
  organizationId       String
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalName            String
  dba                  String?
  einEncrypted         String
  einLast4             String           @default("0000")
  entityType           String           // S_CORP, C_CORP, LLC, PARTNERSHIP, SOLE_PROP
  primaryAddress       Json             // { street, city, state, zip }
  payrollContacts      Json             @default("[]")
  taxJurisdictions     String[]         // ["US-FED", "US-CA", "US-NY"]
  defaultPaySchedule   PayFrequency     @default(BIWEEKLY)
  providerConnections  Json             @default("[]")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  registrations        EmployerRegistration[]
  employees            Employee[]
  contractors          Contractor[]
  workerClassifications WorkerClassificationCase[]
  payrollRuns          PayrollRun[]
  payrollLiabilities   PayrollTaxLiability[]
  depositSchedules     PayrollDepositSchedule[]
  payrollReturns       PayrollReturn[]
  w2Records            W2Record[]
  w3Records            W3Record[]
  suiAccounts          StateUnemploymentAccount[]
  localAccounts        LocalPayrollTaxAccount[]
  notices              PayrollNotice[]
  payments             PayrollPayment[]
  reconciliations      PayrollReconciliation[]

  @@index([organizationId])
}

model EmployerRegistration {
  id               String                     @id @default(uuid())
  employerId       String
  employer         Employer                   @relation(fields: [employerId], references: [id], onDelete: Cascade)
  jurisdictionCode String                     // "US-FED", "US-CA", "US-NY", "US-NJ", "US-IL", "US-MA"
  registrationType EmployerRegistrationType
  accountNumber    String
  status           EmployerRegistrationStatus @default(ACTIVE)
  effectiveDate    DateTime
  expirationDate   DateTime?
  filingFrequency  DepositFrequency           @default(MONTHLY)
  credentialsRef   String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([employerId, jurisdictionCode, registrationType])
  @@index([employerId])
}

model Employee {
  id                      String           @id @default(uuid())
  employerId              String
  employer                Employer         @relation(fields: [employerId], references: [id], onDelete: Cascade)
  employeeNumber          String?
  firstName               String
  lastName                String
  ssnEncrypted            String
  ssnLast4                String           @default("0000")
  address                 Json
  workLocationState       String           // "US-CA", "US-NY", etc.
  residentState           String           // "US-CA", "US-NY", etc.
  employmentStatus        EmploymentStatus @default(ACTIVE)
  hireDate                DateTime
  terminationDate         DateTime?
  payFrequency            PayFrequency     @default(BIWEEKLY)
  payRateCents            BigInt           @default(0)
  isSalaried              Boolean          @default(false)
  w4FilingStatus          String           @default("SINGLE")
  w4MultipleJobs          Boolean          @default(false)
  w4ClaimDependentsCents  BigInt           @default(0)
  w4OtherIncomeCents      BigInt           @default(0)
  w4DeductionsCents       BigInt           @default(0)
  w4ExtraWithholdingCents BigInt           @default(0)
  stateWithholdingConfig  Json             @default("{}")
  benefitsConfig          Json             @default("{}")
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  earnings                PayrollEarning[]
  deductions              PayrollDeduction[]
  taxableWages            TaxableWage[]
  withholdings            EmployeeWithholding[]
  employerTaxes           EmployerTax[]
  w2Records               W2Record[]

  @@index([employerId, employmentStatus])
}

model Contractor {
  id               String           @id @default(uuid())
  employerId       String
  employer         Employer         @relation(fields: [employerId], references: [id], onDelete: Cascade)
  contractorNumber String?
  legalName        String
  dba              String?
  tinEncrypted     String
  tinLast4         String           @default("0000")
  businessType     String
  address          Json
  email            String?
  is1099Eligible   Boolean          @default(true)
  status           EmploymentStatus @default(ACTIVE)

  key              String // e.g. "merchant:AMZN_MKTP" or "taxpayer:standard_mileage_election"
  value            Json
  confidence       Float        @default(1.0)
  sourceAgent      String?
  verifiedByUserId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, category, key])
  @@index([organizationId, category])
}

model ProfessionalCorrection {
  id                   String   @id @default(uuid())
  taxCaseId            String
  taxCase              TaxCase  @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)

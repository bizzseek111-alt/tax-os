model SalesTaxProfile {
  id                     String       @id @default(uuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxCaseId              String?
  taxCase                TaxCase?     @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  legalBusinessName      String
  defaultOriginAddress   Json // { street1, street2, city, state, postalCode, country }
  productCatalogType     String       @default("MIXED") // SAAS, TPP, DIGITAL, SERVICES, MIXED
  nexusMonitoringEnabled Boolean      @default(true)
  autoGenerateReturns    Boolean      @default(false)
  activeStates           String[] // e.g. ["CA", "NY", "NJ", "IL", "MA"]
  settings               Json         @default("{}")
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([organizationId])
  @@index([taxCaseId])
}

model SalesTaxJurisdiction {
  id                  String       @id @default(uuid())
  stateCode           String // e.g. "CA", "NY", "NJ", "IL", "MA"
  jurisdictionCode    String       @unique // e.g. "US-CA-06075", "US-NY-36061"
  jurisdictionType    String // STATE, COUNTY, CITY, SPECIAL_DISTRICT, COMPOSITE
  name                String // e.g. "San Francisco County", "Chicago City"
  fipsCode            String?
  stateRate           Float        @default(0.0)
  countyRate          Float        @default(0.0)
  cityRate            Float        @default(0.0)
  specialDistrictRate Float        @default(0.0)
  compositeRate       Float        @default(0.0)
  sourcingRule        SourcingRule @default(DESTINATION)
  effectiveFrom       DateTime     @default(now())
  effectiveTo         DateTime?
  isActive            Boolean      @default(true)
  metadata            Json         @default("{}")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  rates SalesTaxRate[]

  @@index([stateCode])
  @@index([jurisdictionCode])
}

model SalesTaxRate {
  id             String               @id @default(uuid())
  jurisdictionId String
  jurisdiction   SalesTaxJurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  stateCode      String
  postalCode     String?
  rate           Float
  stateRate      Float                @default(0.0)
  countyRate     Float                @default(0.0)
  cityRate       Float                @default(0.0)
  specialRate    Float                @default(0.0)
  version        String               @default("2026.1")
  effectiveDate  DateTime             @default(now())
  expirationDate DateTime?
  isCurrent      Boolean              @default(true)
  createdAt      DateTime             @default(now())

  @@index([stateCode, postalCode])
  @@index([jurisdictionId, isCurrent])
}

model SalesTaxRegistration {
  id                 String             @id @default(uuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stateCode          String // "CA", "NY", "NJ", "IL", "MA"
  registrationNumber String? // e.g. CDTFA permit #, NY Certificate of Authority #
  status             RegistrationStatus @default(NOT_REQUIRED)
  filingFrequency    FilingFrequency    @default(QUARTERLY)
  effectiveDate      DateTime?
  expirationDate     DateTime?
  stateTaxAgency     String // e.g. "CDTFA", "NYS Dept of Taxation and Finance", "Illinois Dept of Revenue"
  autoFileEnabled    Boolean            @default(false)
  lastFilingDate     DateTime?
  nextDueDate        DateTime?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([organizationId, stateCode])
  @@index([stateCode, status])
}

model EconomicNexusMeasurement {
  id                            String      @id @default(uuid())
  taxCaseId                     String
  taxCase                       TaxCase     @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  stateCode                     String // "CA", "NY", "NJ", "IL", "MA"
  measurementPeriod             String // "2026-CALENDAR", "2026-TRAILING-12M"
  grossSalesCents               BigInt      @default(0)
  retailSalesCents              BigInt      @default(0)
  taxableSalesCents             BigInt      @default(0)
  transactionCount              Int         @default(0)
  statutorySalesThresholdCents  BigInt      @default(10000000) // e.g. $100,000 or $500,000
  statutoryTransactionThreshold Int? // e.g. 200 or 100 or null
  percentageOfSalesThreshold    Float       @default(0.0)
  percentageOfTxnThreshold      Float?
  status                        NexusStatus @default(NO_NEXUS)
  breachedAt                    DateTime?
  evaluationDate                DateTime    @default(now())
  ruleVersion                   String      @default("2026.1")
  details                       Json        @default("{}")
  createdAt                     DateTime    @default(now())
  updatedAt                     DateTime    @updatedAt

  @@index([taxCaseId, stateCode])
  @@index([stateCode, status])
}

model PhysicalNexusFact {
  id                 String      @id @default(uuid())
  taxCaseId          String
  taxCase            TaxCase     @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  stateCode          String // "CA", "NY", "NJ", "IL", "MA"
  factType           String // INVENTORY_3PL, REMOTE_EMPLOYEE, PHYSICAL_OFFICE, WAREHOUSE, TRADE_SHOW, AFFILIATE
  description        String
  locationAddress    Json // { street1, city, state, postalCode }
  activeFrom         DateTime
  activeTo           DateTime?
  payrollCount       Int?
  propertyValueCents BigInt?
  status             NexusStatus @default(NEXUS_ESTABLISHED)
  verifiedByReviewer Boolean     @default(false)
  evidenceId         String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([taxCaseId, stateCode])
  @@index([stateCode, factType])
}

model NexusEvent {
  id           String    @id @default(uuid())
  taxCaseId    String
  taxCase      TaxCase   @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  stateCode    String
  eventType    String // THRESHOLD_WARNING_75, THRESHOLD_WARNING_90, NEXUS_BREACHED, PHYSICAL_NEXUS_DETECTED, REGISTRATION_REQUIRED, DEREGISTRATION_ELIGIBLE
  triggeredAt  DateTime  @default(now())
  payload      Json      @default("{}")
  reviewTaskId String?
  isResolved   Boolean   @default(false)
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([taxCaseId, stateCode])
  @@index([stateCode, eventType])
}

model ProductTaxCategory {
  id                   String       @id @default(uuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code                 String // e.g. "SAAS_SUBSCRIPTION", "TPP_CLOTHING", "CONSULTING_SVC"
  name                 String
  description          String?
  standardCategory     String // SAAS, DIGITAL_GOODS, TANGIBLE_PERSONAL_PROPERTY, PROFESSIONAL_SERVICES, MAINTENANCE, SHIPPING
  stateTaxabilityRules Json         @default("{}") // e.g. { "CA": "EXEMPT", "NY": "TAXABLE", "NJ": "TAXABLE" }
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  salesTaxLines       SalesTaxLine[]
  taxabilityDecisions TaxabilityDecision[]

  @@unique([organizationId, code])
}

model SalesTaxCustomer {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerNumber  String
  name            String
  customerType    String       @default("B2C") // B2B, B2C, RESELLER, NON_PROFIT, GOVERNMENT
  taxIdentifier   String? // EIN or State Tax ID
  billingAddress  Json         @default("{}")
  shippingAddress Json         @default("{}")
  isExempt        Boolean      @default(false)
  exemptionType   String? // RESALE, CHARITABLE, GOVERNMENT, EDUCATIONAL
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  exemptionCertificates ExemptionCertificate[]
  salesTransactions     SalesTransaction[]

  @@unique([organizationId, customerNumber])
}

model ExemptionCertificate {
  id                   String                     @id @default(uuid())
  organizationId       String
  organization         Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId           String
  customer             SalesTaxCustomer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stateCode            String // "CA", "NY", "NJ", "IL", "MA"
  certificateNumber    String
  certificateType      String                     @default("RESALE") // RESALE, DIRECT_PAY, GOVERNMENT, CHARITABLE, MANUFACTURING
  issuedDate           DateTime
  expirationDate       DateTime?
  status               ExemptionCertificateStatus @default(PENDING_VERIFICATION)
  verifiedByReviewerId String?
  documentId           String?
  documentUri          String?
  metadata             Json                       @default("{}")
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([organizationId, stateCode])
  @@index([customerId, status])
}

model SalesTransaction {
  id                       String               @id @default(uuid())
  organizationId           String
  organization             Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxCaseId                String?
  taxCase                  TaxCase?             @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  sourceChannel            String               @default("DIRECT_STORE") // DIRECT_STORE, SHOPIFY, STRIPE, AMAZON, WOOCOMMERCE, MANUAL
  externalTransactionId    String
  transactionType          SalesTransactionType @default(SALE)
  transactionDate          DateTime
  originalTransactionId    String?
  customerId               String?
  customer                 SalesTaxCustomer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  originAddress            Json // { street1, city, state, postalCode, country }
  destinationAddress       Json // { street1, city, state, postalCode, country }
  isMarketplaceFacilitated Boolean              @default(false)
  marketplaceName          String? // "Amazon", "Shopify Marketplace", "Walmart"
  grossAmountCents         BigInt               @default(0)
  nonTaxableAmountCents    BigInt               @default(0)
  taxableAmountCents       BigInt               @default(0)
  taxCollectedCents        BigInt               @default(0)
  calculatedTaxCents       BigInt               @default(0)
  currency                 String               @default("USD")
  sourcingMethod           SourcingRule         @default(DESTINATION)
  destinationState         String
  destinationZip           String
  reconciledStatus         String               @default("UNRECONCILED") // UNRECONCILED, RECONCILED, EXCEPTION_DISCREPANCY, EXEMPTION_MISSING
  metadata                 Json                 @default("{}")
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  lines SalesTaxLine[]

  @@unique([organizationId, sourceChannel, externalTransactionId])
  @@index([taxCaseId, destinationState])
  @@index([transactionDate])
}

model SalesTaxLine {
  id                  String              @id @default(uuid())
  salesTransactionId  String
  salesTransaction    SalesTransaction    @relation(fields: [salesTransactionId], references: [id], onDelete: Cascade)
  lineNumber          Int                 @default(1)
  productCategoryId   String?
  productCategory     ProductTaxCategory? @relation(fields: [productCategoryId], references: [id], onDelete: SetNull)
  productSku          String?
  productDescription  String
  quantity            Float               @default(1.0)
  unitPriceCents      BigInt              @default(0)
  grossAmountCents    BigInt              @default(0)
  isTaxable           Boolean             @default(true)
  exemptionReason     String?
  stateRate           Float               @default(0.0)
  countyRate          Float               @default(0.0)
  cityRate            Float               @default(0.0)
  specialDistrictRate Float               @default(0.0)
  compositeRate       Float               @default(0.0)
  calculatedTaxCents  BigInt              @default(0)
  taxCollectedCents   BigInt              @default(0)
  jurisdictionCode    String?
  createdAt           DateTime            @default(now())

  @@index([salesTransactionId])
  @@index([productCategoryId])
}

model TaxabilityDecision {
  id                  String              @id @default(uuid())
  taxCaseId           String
  taxCase             TaxCase             @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  productCategoryId   String?
  productTaxCategory  ProductTaxCategory? @relation(fields: [productCategoryId], references: [id], onDelete: SetNull)
  stateCode           String // "CA", "NY", "NJ", "IL", "MA"
  decision            ProductTaxability   @default(TAXABLE)
  ruleCitation        String // e.g. "Cal. Rev. & Tax. Code § 6016", "N.Y. Tax Law § 1105(c)(1)"
  determinationReason String
  isReviewerOverride  Boolean             @default(false)
  reviewerUserId      String?
  ruleSetVersion      String              @default("2026.1")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([taxCaseId, stateCode])
  @@index([productCategoryId, stateCode])
}

model UseTaxPosition {
  id                    String   @id @default(uuid())
  taxCaseId             String
  taxCase               TaxCase  @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  purchaseDate          DateTime
  vendorName            String
  description           String
  purchaseAmountCents   BigInt   @default(0)
  untaxedAmountCents    BigInt   @default(0)
  stateCode             String // "CA", "NY", "NJ", "IL", "MA"
  jurisdictionCode      String?
  applicableRate        Float    @default(0.0)
  calculatedUseTaxCents BigInt   @default(0)
  isSelfAssessed        Boolean  @default(true)
  status                String   @default("CALCULATED") // CALCULATED, INCLUDED_IN_RETURN, PAID
  sourceTransactionId   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([taxCaseId, stateCode])
}

model SalesTaxReturnPeriod {
  id                String          @id @default(uuid())
  taxCaseId         String
  taxCase           TaxCase         @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  stateCode         String // "CA", "NY", "NJ", "IL", "MA"
  jurisdictionCode  String // e.g. "US-CA", "US-NY"
  periodKey         String // e.g. "2026-Q1", "2026-M03", "2026-ANNUAL"
  filingFrequency   FilingFrequency @default(QUARTERLY)
  periodYear        Int             @default(2026)
  periodQuarter     Int? // 1, 2, 3, 4
  periodMonth       Int? // 1-12
  startDate         DateTime
  endDate           DateTime
  dueDate           DateTime
  status            String          @default("OPEN") // OPEN, CALCULATING, READY_FOR_REVIEW, FILED, CLOSED
  grossSalesCents   BigInt          @default(0)
  taxableSalesCents BigInt          @default(0)
  taxCollectedCents BigInt          @default(0)
  totalTaxDueCents  BigInt          @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  returns SalesTaxReturn[]

  @@unique([taxCaseId, stateCode, periodKey])
  @@index([taxCaseId, stateCode])
}

model SalesTaxReturn {
  id                          String               @id @default(uuid())
  organizationId              String
  organization                Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxCaseId                   String
  taxCase                     TaxCase              @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  taxObligationId             String?
  taxObligation               TaxObligation?       @relation(fields: [taxObligationId], references: [id], onDelete: SetNull)
  returnPeriodId              String
  returnPeriod                SalesTaxReturnPeriod @relation(fields: [returnPeriodId], references: [id], onDelete: Cascade)
  stateCode                   String // "CA", "NY", "NJ", "IL", "MA"
  returnFormName              String // "CDTFA_401_A", "NY_ST_100", "IL_ST_1", "NJ_ST_50", "MA_ST_9"
  version                     Int                  @default(1)
  status                      SalesTaxReturnStatus @default(DRAFT)
  grossSalesCents             BigInt               @default(0)
  marketplaceSalesCents       BigInt               @default(0)
  exemptSalesCents            BigInt               @default(0)
  taxableSalesCents           BigInt               @default(0)
  stateTaxCents               BigInt               @default(0)
  localTaxCents               BigInt               @default(0)
  specialDistrictTaxCents     BigInt               @default(0)
  totalTaxDueCents            BigInt               @default(0)
  creditsAndPrepaymentsCents  BigInt               @default(0)
  vendorCollectionCreditCents BigInt               @default(0)
  penaltiesAndInterestCents   BigInt               @default(0)
  netTaxPayableCents          BigInt               @default(0)
  lineItems                   Json                 @default("{}") // Form line item breakdown
  schedules                   Json                 @default("{}") // County/district allocations
  calculationLineage          Json                 @default("{}") // Traceability to transactions
  preparedByAgentId           String?
  approvedByReviewerId        String?
  authorizedByTaxpayerAt      DateTime?
  filedAt                     DateTime?
  confirmationNumber          String?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  payments SalesTaxPayment[]

  @@index([taxCaseId, stateCode])
  @@index([organizationId, returnFormName])
  @@index([status])
}

model SalesTaxPayment {
  id                 String                @id @default(uuid())
  salesTaxReturnId   String
  salesTaxReturn     SalesTaxReturn        @relation(fields: [salesTaxReturnId], references: [id], onDelete: Cascade)
  paymentAmountCents BigInt                @default(0)
  paymentMethod      String                @default("ACH_DEBIT")
  bankAccountId      String?
  confirmationNumber String?
  scheduledDate      DateTime
  processedDate      DateTime?
  status             SalesTaxPaymentStatus @default(SCHEDULED)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([salesTaxReturnId, status])
}

model SalesTaxNotice {
  id                    String                 @id @default(uuid())
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stateCode             String // "CA", "NY", "NJ", "IL", "MA"
  noticeDate            DateTime
  receivedDate          DateTime               @default(now())
  noticeType            String // ASSESSMENT, INQUIRY, DEFICIENCY, AUDIT_NOTICE
  noticeNumber          String?
  agencyName            String // "CDTFA", "NYS DTF", "IDOR", "NJ Div of Taxation", "Mass DOR"
  periodCovered         String?
  assessedTaxCents      BigInt                 @default(0)
  assessedPenaltyCents  BigInt                 @default(0)
  assessedInterestCents BigInt                 @default(0)
  totalAssessmentCents  BigInt                 @default(0)
  responseDueDate       DateTime?
  severity              SalesTaxNoticeSeverity @default(INQUIRY)
  status                String                 @default("OPEN") // OPEN, IN_REVIEW, RESPONDED, RESOLVED, CLOSED
  documentId            String?
  reviewTaskId          String?
  resolutionSummary     String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([organizationId, stateCode])
  @@index([severity, status])
}


model TaxCaseMessage {
  id                String   @id @default(uuid())
  taxCaseId         String
  taxCase           TaxCase  @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  senderUserId      String
  sender            User     @relation(fields: [senderUserId], references: [id])
  senderRole        String
  recipientScope    String   @default("ALL") // ALL, CUSTOMER_REVIEWER, REVIEWER_OPS, REVIEWER_SENIOR, REVIEWER_ATTORNEY
  content           String
  isPrivilegedLegal Boolean  @default(false)
  attachments       Json     @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([taxCaseId, recipientScope])
}

model QualityReview {
  id                String      @id @default(uuid())
  taxCaseId         String
  taxCase           TaxCase     @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  reviewTaskId      String?
  reviewTask        ReviewTask? @relation(fields: [reviewTaskId], references: [id], onDelete: SetNull)
  qaReviewerId      String
  qaReviewer        User        @relation(fields: [qaReviewerId], references: [id])
  samplingReason    String // RANDOM_SAMPLE, HIGH_RISK, NEW_REVIEWER, LARGE_DEDUCTION, MANUAL_OVERRIDE, AGENT_CONFLICT
  status            String      @default("PENDING") // PENDING, PASS, CORRECTION_REQUIRED, ESCALATED
  action            String? // PASS, CORRECTION_REQUIRED, ESCALATE, PROCESS_ISSUE, AGENT_ISSUE, RULE_ISSUE
  score             Float?
  findings          Json        @default("[]")
  correctiveActions String?
  completedAt       DateTime?
  createdAt         DateTime    @default(now())

  @@index([taxCaseId, status])
  @@index([qaReviewerId])
}

model ServiceLevelPolicy {
  id                       String   @id @default(uuid())
  name                     String
  domain                   String   @default("INCOME_TAX")
  tier                     String   @default("FULL_TAX_OS")
  targetTurnaroundHours    Int      @default(24)
  warningThresholdHours    Int      @default(18)
  escalationThresholdHours Int      @default(30)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())

  reviewTasks ReviewTask[]
}

model ReviewSignoff {
  id                 String    @id @default(uuid())
  taxCaseId          String
  taxCase            TaxCase   @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  reviewVersion      Int       @default(1)
  approvedByUserId   String
  approvedByUser     User      @relation(fields: [approvedByUserId], references: [id])
  approvedAt         DateTime  @default(now())
  calculationRunId   String
  ruleSetVersion     String
  inputFactHash      String
  checklistResults   Json      @default("{}")
  isInvalidated      Boolean   @default(false)
  invalidatedAt      DateTime?
  invalidationReason String?
  createdAt          DateTime  @default(now())

  @@index([taxCaseId, reviewVersion])
}

model CaseLock {
  id             String   @id @default(uuid())
  taxCaseId      String   @unique
  taxCase        TaxCase  @relation(fields: [taxCaseId], references: [id], onDelete: Cascade)
  lockedByUserId String
  lockedByUser   User     @relation(fields: [lockedByUserId], references: [id])
  lockedAt       DateTime @default(now())
  expiresAt      DateTime
  reason         String

  @@index([taxCaseId])
}

// ============================================================================
// PHASE 7: SALES & USE TAX ENGINE DOMAIN MODELS
// ============================================================================

enum NexusType {
  PHYSICAL
  ECONOMIC
  AFFILIATE
  CLICK_THROUGH
  MARKETPLACE
}

enum NexusStatus {
  NO_NEXUS
  APPROACHING_THRESHOLD
  NEXUS_ESTABLISHED
  REGISTERED
  DEREGISTERED
}

enum RegistrationStatus {
  NOT_REQUIRED
  APPROACHING_THRESHOLD
  REGISTRATION_PENDING
  REGISTERED
  EXPIRED
  SUSPENDED
  DEREGISTERED
}

enum FilingFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  ANNUALLY
  OCCASIONAL
}

enum ProductTaxability {
  TAXABLE
  EXEMPT
  NON_TAXABLE
  PARTIALLY_TAXABLE
  CONDITIONAL
}

enum SourcingRule {
  DESTINATION
  ORIGIN
  MIXED
}

enum MarketplaceStatus {
  DIRECT_SALE
  MARKETPLACE_FACILITATED
}

enum ExemptionCertificateStatus {
  VALID
  EXPIRED
  PENDING_VERIFICATION
  REJECTED
  REVOKED
}

enum SalesTransactionType {
  SALE
  REFUND
  CREDIT_MEMO
  EXCHANGE
}

enum SalesTaxReturnStatus {
  DRAFT
  READY_FOR_REVIEW
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  AUTHORIZED_BY_TAXPAYER
  READY_FOR_FILING
  FILED
